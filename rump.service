[Unit]
Description=MPD web frontend written in Rust
After=remote-fs.target network.target

[Install]
WantedBy=multi-user.target

[Service]
User=stepo
Group=stepo
Type=simple
ExecStart=/home/stepo/rump/rump
WorkingDirectory=/home/stepo/rump/
TimeoutStopSec=5
KillMode=process
Restart=on-failure
Environment=RUST_LOG=warn
